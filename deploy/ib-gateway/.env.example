# IBKR 登录凭证（建议使用专门的 API 交易子账号或先在模拟盘 paper 测试）
TWS_USERID=your_ibkr_username
TWS_PASSWORD=your_ibkr_password

# 交易模式：paper（模拟盘，对应宿主机 4002 端口）或 live（实盘，对应宿主机 4001 端口）
TRADING_MODE=paper

# 必须设为 no 才允许下单与撤单；若仅用于同步持仓/成交而不自动挂单可设为 yes
READ_ONLY_API=no

# 二次验证（IB Key）超时策略：restart / exit
TWOFA_TIMEOUT_ACTION=restart
RELOGIN_AFTER_TWOFA_TIMEOUT=yes

# 每日自动重启时间（IB Gateway 强制要求每日重启一次，默认选在美股收盘/亚盘低谷）
TIME_ZONE=Asia/Shanghai
AUTO_RESTART_TIME=05:30 AM

# 可选：如果需要通过 SSH 隧道连接 VNC 调试，可设置密码；留空则不开启 VNC 密码访问
VNC_SERVER_PASSWORD=
